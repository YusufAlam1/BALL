{
  "name": "BALL (Python + Claude Code)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  // On local Windows dev you can re-add these mounts to reuse your host
  // Claude Code credentials without re-logging in.  They are omitted here
  // so the devcontainer also builds cleanly in GitHub Codespaces, where
  // USERPROFILE is unset.  Run `claude login` once after the container starts.
  //
  // "mounts": [
  //   "source=${localEnv:USERPROFILE}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
  //   "source=${localEnv:USERPROFILE}/.claude.json,target=/home/vscode/.claude.json,type=bind"
  // ],

  "remoteUser": "vscode",

  "forwardPorts": [8888],
  "portsAttributes": {
    "8888": { "label": "Jupyter", "onAutoForward": "notify" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "anthropic.claude-code"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },

  // Runs once after the container is created. Confirms both tools are ready.
  "postCreateCommand": "pip install -e . && python --version && claude --version || echo 'Run: claude login (inside the container) if not already authenticated'"
}
