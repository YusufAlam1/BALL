# --- Supabase (remote/full data store; used by connect.py, ping.py, ETL) ----
SUPABASE_URL=
SUPABASE_KEY=

# --- Direct Postgres access to the same Supabase project (optional) ---------
PGSQL-PASS=
HOST=
PORT=
USER=postgres
DBNAME=postgres

